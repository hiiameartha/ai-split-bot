LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
OPENAI_API_KEY=
GOOGLE_SHEET_ID=
# GOOGLE_CREDENTIALS_JSON=
EXCHANGE_API_KEY=
PORT=3000
# 記帳時間時區（IANA，例 Asia/Taipei、Asia/Kuala_Lumpur）
MOODPAY_TIMEZONE=Asia/Taipei
# 選填：舊版 Sheet 無 chatId 的列，歸屬哪個 LINE 帳本（groupId 或 userId）
# LEGACY_CHAT_ID=
# 選填：Giphy 梗圖靜態圖（https://developers.giphy.com/ → Create App → API Key）
# LINE 不支援 .gif，程式會自動改用 Giphy 的 still 圖（JPEG）
GIPHY_API_KEY=
# 聊天截圖匯入（正數=positivePayer 幫 userName 付）
CHAT_IMPORT_POSITIVE_PAYER=男友
CHAT_IMPORT_USER=我
CHAT_IMPORT_CURRENCY=MYR
CHAT_IMPORT_YEAR=2025
